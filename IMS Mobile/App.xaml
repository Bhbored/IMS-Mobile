<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="IMS_Mobile.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:IMS_Mobile.Converters"
    xmlns:local="clr-namespace:IMS_Mobile">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/CustomeStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/DataTemplates.xaml" />
                <ResourceDictionary Source="Resources/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StringNotNullOrEmptyConverter x:Key="StringToBoolConverter" />
            <converters:PaidStatusToColorConverter x:Key="PaidStatusToColorConverter" />
            <converters:PaidStatusToBorderColorConverter x:Key="PaidStatusToBorderColorConverter" />
            <converters:PaidStatusToBadgeColorConverter x:Key="PaidStatusToBadgeColorConverter" />
            <converters:HasItemsConverter x:Key="HasItemsConverter" />
            <converters:GlobalCurrencyConverter x:Key="GlobalCurrencyConverter" />
            <converters:IsEmptyConverter x:Key="IsEmptyConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
