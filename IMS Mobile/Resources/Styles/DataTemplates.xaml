            StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    Background="#F5F5F5"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 8"
                    VerticalOptions="Center"
                    WidthRequest="40">
                    <Label
                        FontSize="18"
                        HorizontalOptions="Center"
                        Text="📋"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">
                    <Label
                        FontFamily="poppinbold"
                        FontSize="14"
                        Text="{Binding Id, StringFormat='Transaction #{0}'}"
                        TextColor="{AppThemeBinding Light={StaticResource Black},
                                                    Dark={StaticResource DarkOnSurface}}" />
                    <Label
                        FontFamily="poppinregular"
                        FontSize="12"
                        Text="{Binding FormattedDate}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                    Dark={StaticResource DarkOnSurface}}" />
                    <Label
                        FontFamily="poppinregular"
                        FontSize="11"
                        Text="Sale (On Credit)"
                        TextColor="#9E9E9E" />
                </VerticalStackLayout>

                <Label
                    Grid.Column="2"
                    FontFamily="poppinbold"
                    FontSize="16"
                    Text="{Binding totalamount, Converter={StaticResource GlobalCurrencyConverter}}"
                    TextColor="#9E9E9E"
                    VerticalOptions="Center" />
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>