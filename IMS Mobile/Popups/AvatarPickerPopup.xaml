<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="IMS_Mobile.Popups.AvatarPickerPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Margin="20"
    Padding="0"
    BackgroundColor="White"
    CanBeDismissedByTappingOutsideOfPopup="True"
    HeightRequest="550"
    WidthRequest="350">

    <Grid Padding="10" RowDefinitions="Auto,*,Auto">
        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,20"
            ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontFamily="poppinbold"
                FontSize="20"
                Text="Choose Your Avatar"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                BackgroundColor="Transparent"
                Clicked="OnCloseClicked"
                FontSize="20"
                HeightRequest="40"
                Text="✕"
                TextColor="Gray"
                VerticalOptions="Center"
                WidthRequest="40" />
        </Grid>

        <!--  Avatar Grid  -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding AvatarOptions}"
            SelectionMode="Single">
            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    HorizontalItemSpacing="20"
                    Orientation="Vertical"
                    Span="2"
                    VerticalItemSpacing="20" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="10"
                        BackgroundColor="White"
                        Stroke="LightGray"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type toolkit:Popup}}, Path=BindingContext.SelectAvatarCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Image
                                Aspect="AspectFit"
                                HeightRequest="80"
                                Source="{Binding .}"
                                WidthRequest="80" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--  Footer  -->
        <Border
            Grid.Row="2"
            Margin="0,20,0,0"
            Padding="16,12"
            BackgroundColor="#F8F9FA"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="0">
            <Label
                FontFamily="poppinregular"
                FontSize="14"
                HorizontalOptions="Center"
                Text="Tap an avatar to select it"
                TextColor="Gray" />
        </Border>
    </Grid>
</toolkit:Popup>
