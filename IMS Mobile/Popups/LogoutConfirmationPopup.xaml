<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="IMS_Mobile.Popups.LogoutConfirmationPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Background="{AppThemeBinding Light={StaticResource White},
                                 Dark={StaticResource DarkSurface}}"
    CanBeDismissedByTappingOutsideOfPopup="False"
    HeightRequest="300"
    WidthRequest="300">

    <VerticalStackLayout Spacing="20">
        <!--  Header Icon  -->
        <Border
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100},
                                              Dark={StaticResource DarkSurfaceVariant}}"
            HeightRequest="60"
            HorizontalOptions="Center"
            IsVisible="{Binding IsNotLoading}"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 30"
            WidthRequest="60">
            <Image
                HeightRequest="30"
                HorizontalOptions="Center"
                Source="exit.png"
                VerticalOptions="Center"
                WidthRequest="30" />
        </Border>

        <!--  Title  -->
        <Label
            FontAttributes="Bold"
            FontSize="20"
            HorizontalOptions="Center"
            IsVisible="{Binding IsNotLoading}"
            Text="Logout"
            TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                        Dark={StaticResource DarkOnSurface}}" />
        <Label
            FontAttributes="Bold"
            FontSize="20"
            HorizontalOptions="Center"
            IsVisible="{Binding IsLoading}"
            Text="⚠️ Logging Out"
            TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                        Dark={StaticResource DarkOnSurface}}"
            VerticalOptions="Start" />

        <!--  Message  -->
        <Label
            FontSize="14"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            IsVisible="{Binding IsNotLoading}"
            Text="Are you sure you want to logout from the application?"
            TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                        Dark={StaticResource DarkSurfaceVariant}}" />
        <!--  Loading Indicator  -->
        <Image
            Margin="0,80,0,0"
            HeightRequest="60"
            HorizontalOptions="Center"
            IsAnimationPlaying="True"
            IsVisible="{Binding IsLoading}"
            Source="loader.gif"
            VerticalOptions="Center" />

        <!--  Buttons  -->
        <Grid Margin="0,10,0,0" ColumnDefinitions="*,10,*">
            <Button
                Grid.Column="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100},
                                                  Dark={StaticResource DarkSurfaceVariant}}"
                Clicked="OnCancelClicked"
                CornerRadius="12"
                FontFamily="poppinbold"
                HeightRequest="45"
                IsVisible="{Binding IsNotLoading}"
                Text="Cancel"
                TextColor="{AppThemeBinding Light={StaticResource DarkBackground},
                                            Dark={StaticResource WhiteBrush}}" />

            <Button
                Grid.Column="2"
                Background="{AppThemeBinding Light={StaticResource ModernGreen},
                                             Dark={StaticResource ModernGreenDark}}"
                Command="{Binding Logout}"
                CornerRadius="12"
                FontFamily="poppinbold"
                HeightRequest="45"
                IsVisible="{Binding IsNotLoading}"
                Text="Logout"
                TextColor="{AppThemeBinding Light={StaticResource WhiteBrush},
                                            Dark={StaticResource WhiteBrush}}" />
        </Grid>
    </VerticalStackLayout>
</toolkit:Popup>