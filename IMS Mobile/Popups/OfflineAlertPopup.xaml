<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="IMS_Mobile.Popups.OfflineAlertPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Background="Transparent"
    CanBeDismissedByTappingOutsideOfPopup="False">
    <Border
        Padding="25"
        BackgroundColor="White"
        Stroke="#E0E0E0"
        StrokeShape="RoundRectangle 20"
        StrokeThickness="1"
        WidthRequest="300">

        <VerticalStackLayout Spacing="20">
            <!--  Header Icon  -->
            <Border
                BackgroundColor="#FFF8E1"
                HeightRequest="60"
                HorizontalOptions="Center"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 30"
                WidthRequest="60">
                <Image
                    HeightRequest="30"
                    HorizontalOptions="Center"
                    Source="wifi_off.png"
                    VerticalOptions="Center"
                    WidthRequest="30" />
            </Border>

            <!--  Title  -->
            <Label
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="⚠️ Offline Mode"
                TextColor="#333333" />

            <!--  Message  -->
            <Label
                FontSize="14"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="You're offline. Changes will be saved locally and synced when you're back online."
                TextColor="#666666" />

            <!--  OK Button  -->
            <Button
                BackgroundColor="#4CAF50"
                Clicked="OnContinueClicked"
                CornerRadius="12"
                FontFamily="poppinbold"
                HeightRequest="45"
                Text="Continue"
                TextColor="White" />
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>