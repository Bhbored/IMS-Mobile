<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="IMS_Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:IMS_Mobile.MVVM.Views"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource White},
    Dark={StaticResource Gray400}}"
    Shell.FlyoutBehavior="Flyout">

    <!--  Flyout Header  -->
    <Shell.FlyoutHeader>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="100" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!--  Avatar  -->
            <Border
                Grid.Row="1"
                Padding="2"
                Background="#4CAF50"
                HorizontalOptions="Center"
                Stroke="#4CAF50"
                StrokeShape="RoundRectangle 50"
                StrokeThickness="2"
                VerticalOptions="Center">
                <Image
                    x:Name="userAvatar"
                    Aspect="AspectFill"
                    HeightRequest="80"
                    Source="user.png"
                    WidthRequest="80" />
            </Border>

            <!--  Display Name  -->
            <Label
                x:Name="userNameLabel"
                Grid.Row="2"
                Margin="0,5,0,0"
                FontAttributes="Bold"
                FontSize="16"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="User Name"
                TextColor="{AppThemeBinding Light={StaticResource Black},
                Dark={StaticResource DarkOnSurface}}" />

            <!--  User Email/Role  -->
            <Label
                x:Name="userEmailLabel"
                Grid.Row="3"
                Margin="0,0,0,5"
                FontSize="12"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="user@example.com"
                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                Dark={StaticResource DarkSurfaceVariant}}" />
        </Grid>
    </Shell.FlyoutHeader>

    <!--  Login/Signup Routes (Not in Flyout)  -->
    <ShellContent
        ContentTemplate="{DataTemplate views:LoadingPage}"
        Route="LoadingPage"
        Shell.FlyoutBehavior="Disabled"
        Shell.FlyoutItemIsVisible="False" />

    <ShellContent
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"
        Shell.FlyoutBehavior="Disabled"
        Shell.FlyoutItemIsVisible="False" />

    <ShellContent
        ContentTemplate="{DataTemplate views:SignUpPage}"
        Route="SignUpPage"
        Shell.FlyoutBehavior="Disabled"
        Shell.FlyoutItemIsVisible="False" />

    <!--  Main App Content with Flyout  -->
    <FlyoutItem Title="Dashboard" Icon="home.png">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:HomePage}"
            Icon="home.png"
            Route="HomePage" />
        <ShellContent
            Title="Contacts"
            ContentTemplate="{DataTemplate views:ContactsPage}"
            Icon="contact.png"
            Route="ContactsPage" />
        <ShellContent
            Title="Inventory"
            ContentTemplate="{DataTemplate views:InventoryPage}"
            Icon="products.png"
            Route="InventoryPage" />
        <ShellContent
            Title="Reports"
            ContentTemplate="{DataTemplate views:ReportsPage}"
            Icon="reports.png"
            Route="ReportsPage" />
        <ShellContent
            Title="Sell Products"
            ContentTemplate="{DataTemplate views:SellProducts}"
            Icon="sell.png"
            Route="SellProducts" />
        <ShellContent
            Title="Restock"
            ContentTemplate="{DataTemplate views:BuyProducts}"
            Icon="buy.png"
            Route="BuyProducts" />
    </FlyoutItem>

    <FlyoutItem Title="About Us" Icon="about.png">
        <ShellContent ContentTemplate="{DataTemplate views:AboutUsPage}" Route="AboutUsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Contact Us" Icon="contact.png">
        <ShellContent ContentTemplate="{DataTemplate views:ContactUsPage}" Route="ContactUsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Settings" Icon="settings.png">
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsPage" />
    </FlyoutItem>

    <!--  Separator  -->
    <MenuItem IsEnabled="False" Text="--------------------------------------------" />

    <!--  Logout Button at Bottom  -->
    <MenuItem
        Clicked="MenuItem_Clicked"
        IconImageSource="logout.png"
        Text="Logout" />

    <!--  Tab Bar Styling  -->
    <Shell.TabBarForegroundColor>
        <AppThemeBinding Dark="{StaticResource ModernGreen}" Light="{StaticResource ModernAccent}" />
    </Shell.TabBarForegroundColor>
    <Shell.TabBarTitleColor>
        <AppThemeBinding Dark="{StaticResource ModernGreen}" Light="{StaticResource ModernAccent}" />
    </Shell.TabBarTitleColor>
    <Shell.TabBarBackgroundColor>
        <AppThemeBinding Dark="{StaticResource DarkSurface}" Light="{StaticResource White}" />
    </Shell.TabBarBackgroundColor>
    <Shell.TabBarUnselectedColor>
        <AppThemeBinding Dark="{StaticResource DarkOnSurface}" Light="{StaticResource Gray500}" />
    </Shell.TabBarUnselectedColor>

</Shell>