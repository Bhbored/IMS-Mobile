<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IMS_Mobile.MVVM.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Controls="clr-namespace:IMS_Mobile.Controls"
    xmlns:Converters="clr-namespace:IMS_Mobile.Converters"
    xmlns:Models="clr-namespace:IMS_Mobile.MVVM.Models"
    xmlns:ViewModels="clr-namespace:IMS_Mobile.MVVM.ViewModels"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    x:DataType="ViewModels:ReportsVM"
    BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                      Dark={StaticResource DarkBackground}}"
    Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Converters:GlobalCurrencyConverter x:Key="GlobalCurrencyConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Margin="20,0,20,10"
            ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                HorizontalOptions="Center"
                StyleClass="TitleStyle"
                Text="Reports" />
            <Border
                Grid.Column="1"
                Background="{AppThemeBinding Light={StaticResource Gray100},
                                             Dark={StaticResource DarkSurface}}"
                HeightRequest="40"
                HorizontalOptions="End"
                StrokeShape="RoundRectangle 8"
                VerticalOptions="End"
                WidthRequest="40">
                <Label
                    FontSize="20"
                    HorizontalOptions="Center"
                    Text="📊"
                    VerticalOptions="Center" />
            </Border>
        </Grid>

        <!--  Content  -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,0,20,20" Spacing="20">

                <!--  Summary Cards Grid  -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="15"
                    RowDefinitions="*,*"
                    RowSpacing="15">

                    <!--  Cash Flow Card  -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        StyleClass="CashFlowCardStyle">
                        <VerticalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label
                                FontFamily="poppinbold"
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="Cash Flow"
                                TextColor="White" />
                            <Label
                                FontFamily="poppinbold"
                                FontSize="22"
                                HorizontalOptions="Center"
                                Text="{Binding CashRegister.CashFlow, Converter={StaticResource GlobalCurrencyConverter}}"
                                TextColor="White" />
                            <Label
                                FontFamily="poppinregular"
                                FontSize="12"
                                HorizontalOptions="Center"
                                Opacity="0.8"
                                Text="Available cash"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Total Sales Card  -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        StyleClass="SalesCardStyle">
                        <VerticalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label
                                FontFamily="poppinbold"
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="Total Sales"
                                TextColor="White" />
                            <Label
                                FontFamily="poppinbold"
                                FontSize="22"
                                HorizontalOptions="Center"
                                Text="{Binding CashRegister.TotalSales, Converter={StaticResource GlobalCurrencyConverter}}"
                                TextColor="White" />
                            <Label
                                FontFamily="poppinregular"
                                FontSize="12"
                                HorizontalOptions="Center"
                                Opacity="0.8"
                                Text="Revenue generated"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Inventory Value Card  -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        StyleClass="InventoryCardStyle">
                        <VerticalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label
                                FontFamily="poppinbold"
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="Inventory Value"
                                TextColor="White" />
                            <Label
                                FontFamily="poppinbold"
                                FontSize="22"
                                HorizontalOptions="Center"
                                Text="{Binding CashRegister.InventoryValue, Converter={StaticResource GlobalCurrencyConverter}}"
                                TextColor="White" />
                            <Label
                                FontFamily="poppinregular"
                                FontSize="12"
                                HorizontalOptions="Center"
                                Opacity="0.8"
                                Text="Current stock value"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Border>

                    <!--  Total Credit Card  -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        StyleClass="CreditCardStyle">
                        <VerticalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label
                                FontFamily="poppinbold"
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="Total Credit"
                                TextColor="White" />
                            <Label
                                FontFamily="poppinbold"
                                FontSize="22"
                                HorizontalOptions="Center"
                                Text="{Binding CashRegister.TotalCredit, Converter={StaticResource GlobalCurrencyConverter}}"
                                TextColor="White" />
                            <Label
                                FontFamily="poppinregular"
                                FontSize="12"
                                HorizontalOptions="Center"
                                Opacity="0.8"
                                Text="Outstanding credit"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!--  Financial Summary Section  -->
                <VerticalStackLayout Spacing="15">
                    <Label
                        Margin="0,10,0,0"
                        StyleClass="SectionTitleStyle"
                        Text="Financial Summary"
                        TextColor="{AppThemeBinding Light={StaticResource Black},
                                                    Dark={StaticResource DarkOnSurface}}" />

                    <!--  Net Profit Calculation with Syncfusion Expander  -->
                    <Border StyleClass="SummaryCardStyle">
                        <syncfusion:SfExpander x:Name="NetProfitExpander" HeaderIconPosition="End">
                            <syncfusion:SfExpander.Header>
                                <Border StyleClass="ExpanderContainerStyle">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                                        <Border
                                            Background="#E8F5E9"
                                            HeightRequest="40"
                                            StrokeShape="RoundRectangle 10"
                                            WidthRequest="40">
                                            <Label
                                                FontFamily="poppinbold"
                                                FontSize="18"
                                                HorizontalOptions="Center"
                                                Text="💰"
                                                VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalOptions="Center">
                                            <Label
                                                FontFamily="poppinbold"
                                                FontSize="16"
                                                Text="Net Profit"
                                                TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                            <Label
                                                FontFamily="poppinregular"
                                                FontSize="13"
                                                Text="Revenue minus expenses"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </syncfusion:SfExpander.Header>
                            <syncfusion:SfExpander.Content>
                                <Border StyleClass="ExpanderContainerStyle">
                                    <VerticalStackLayout Spacing="16">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                FontFamily="poppinregular"
                                                FontSize="14"
                                                Text="Total Sales"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="poppinbold"
                                                FontSize="14"
                                                Text="{Binding CashRegister.TotalSales, Converter={StaticResource GlobalCurrencyConverter}}"
                                                TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                        </Grid>
                                        <BoxView
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100},
                                                                              Dark={StaticResource DarkSurfaceVariant}}"
                                            HeightRequest="1"
                                            HorizontalOptions="Fill" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                FontFamily="poppinregular"
                                                FontSize="14"
                                                Text="Total Credit"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="poppinbold"
                                                FontSize="14"
                                                Text="{Binding CashRegister.TotalCredit, Converter={StaticResource GlobalCurrencyConverter}}"
                                                TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                        </Grid>
                                        <BoxView
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100},
                                                                              Dark={StaticResource DarkSurfaceVariant}}"
                                            HeightRequest="1"
                                            HorizontalOptions="Fill" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                FontFamily="poppinregular"
                                                FontSize="14"
                                                Text="Total Purchases"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="poppinbold"
                                                FontSize="14"
                                                Text="{Binding CashRegister.TotalPurchases, Converter={StaticResource GlobalCurrencyConverter}}"
                                                TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                        </Grid>
                                        <BoxView
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100},
                                                                              Dark={StaticResource DarkSurfaceVariant}}"
                                            HeightRequest="1"
                                            HorizontalOptions="Fill" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                FontFamily="poppinbold"
                                                FontSize="16"
                                                Text="Net Profit"
                                                TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="poppinbold"
                                                FontSize="16"
                                                Text="{Binding CashRegister.NetProfit, Converter={StaticResource GlobalCurrencyConverter}}"
                                                TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                                            Dark={StaticResource ModernGreen}}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </syncfusion:SfExpander.Content>
                        </syncfusion:SfExpander>
                    </Border>

                    <!--  Cash Position with Syncfusion Expander  -->
                    <Border StyleClass="SummaryCardStyle">
                        <syncfusion:SfExpander x:Name="CashPositionExpander" HeaderIconPosition="End">
                            <syncfusion:SfExpander.Header>
                                <Border StyleClass="ExpanderContainerStyle">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                                        <Border
                                            Background="#E3F2FD"
                                            HeightRequest="40"
                                            StrokeShape="RoundRectangle 10"
                                            WidthRequest="40">
                                            <Label
                                                FontFamily="poppinbold"
                                                FontSize="18"
                                                HorizontalOptions="Center"
                                                Text="💳"
                                                VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalOptions="Center">
                                            <Label
                                                FontFamily="poppinbold"
                                                FontSize="16"
                                                Text="Cash Position"
                                                TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                            <Label
                                                FontFamily="poppinregular"
                                                FontSize="13"
                                                Text="Available cash balance"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </syncfusion:SfExpander.Header>
                            <syncfusion:SfExpander.Content>
                                <Border StyleClass="ExpanderContainerStyle">
                                    <VerticalStackLayout Spacing="16">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                FontFamily="poppinregular"
                                                FontSize="14"
                                                Text="Total Sales"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="poppinbold"
                                                FontSize="14"
                                                Text="{Binding CashRegister.TotalSales, Converter={StaticResource GlobalCurrencyConverter}}"
                                                TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                        </Grid>
                                        <BoxView
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100},
                                                                              Dark={StaticResource DarkSurfaceVariant}}"
                                            HeightRequest="1"
                                            HorizontalOptions="Fill" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                FontFamily="poppinregular"
                                                FontSize="14"
                                                Text="Credit Amount"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="poppinbold"
                                                FontSize="14"
                                                Text="{Binding CashRegister.TotalCredit, Converter={StaticResource GlobalCurrencyConverter}}"
                                                TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                        </Grid>
                                        <BoxView
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100},
                                                                              Dark={StaticResource DarkSurfaceVariant}}"
                                            HeightRequest="1"
                                            HorizontalOptions="Fill" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                FontFamily="poppinbold"
                                                FontSize="16"
                                                Text="Available Balance"
                                                TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                            Dark={StaticResource DarkOnSurface}}" />
                                            <Label
                                                Grid.Column="1"
                                                FontFamily="poppinbold"
                                                FontSize="16"
                                                Text="{Binding CashRegister.CashFlow, Converter={StaticResource GlobalCurrencyConverter}}"
                                                TextColor="{AppThemeBinding Light={StaticResource MidnightBlue},
                                                                            Dark={StaticResource DarkInfo}}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </syncfusion:SfExpander.Content>
                        </syncfusion:SfExpander>
                    </Border>

                    <!--  Credit Exposure  -->
                    <Border StyleClass="SummaryCardStyle">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                            <Border
                                Background="#FFF3E0"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 10"
                                WidthRequest="40">
                                <Label
                                    FontFamily="poppinbold"
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                    Text="📝"
                                    VerticalOptions="Center" />
                            </Border>
                            <Grid
                                Grid.Column="1"
                                ColumnDefinitions="*,Auto"
                                HorizontalOptions="Fill">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontFamily="poppinbold"
                                        FontSize="16"
                                        Text="Total Purchases"
                                        TextColor="{AppThemeBinding Light={StaticResource Black},
                                                                    Dark={StaticResource DarkOnSurface}}" />
                                    <Label
                                        FontFamily="poppinregular"
                                        FontSize="13"
                                        Text="Buy amount"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                                    Dark={StaticResource DarkOnSurface}}" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="1"
                                    FontFamily="poppinbold"
                                    FontSize="18"
                                    Text="{Binding CashRegister.TotalPurchases, Converter={StaticResource GlobalCurrencyConverter}}"
                                    TextColor="Red"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!--  Quick Actions  -->
                <VerticalStackLayout Spacing="15">
                    <Label
                        Margin="0,10,0,0"
                        StyleClass="SectionTitleStyle"
                        Text="Quick Actions"
                        TextColor="{AppThemeBinding Light={StaticResource Black},
                                                    Dark={StaticResource DarkOnSurface}}" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="15"
                        RowDefinitions="Auto">
                        <Border Grid.Column="0" StyleClass="ActionCardStyle">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label
                                    FontSize="24"
                                    HorizontalOptions="Center"
                                    Text="📈"
                                    TextColor="White" />
                                <Label
                                    FontFamily="poppinbold"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    Text="Generate Report"
                                    TextColor="White" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" StyleClass="ActionCardStyle">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label
                                    FontSize="24"
                                    HorizontalOptions="Center"
                                    Text="📊"
                                    TextColor="White" />
                                <Label
                                    FontFamily="poppinbold"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    Text="View Analytics"
                                    TextColor="White" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>