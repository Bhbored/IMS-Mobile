<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IMS_Mobile.MVVM.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    Title="LoginPage"
    BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <!--  Header Section  -->
            <VerticalStackLayout Spacing="8">
                <Label
                    HorizontalOptions="Center"
                    Style="{StaticResource TitleStyle}"
                    Text="Welcome Back" />
                <Label
                    HorizontalOptions="Center"
                    Style="{StaticResource RegularTextStyle}"
                    Text="Sign in to continue"
                    TextColor="#666666" />
            </VerticalStackLayout>

            <!--  Login Form  -->
            <VerticalStackLayout Spacing="20">
                <!--  Email Input  -->
                <inputLayout:SfTextInputLayout
                    ContainerType="Outlined"
                    HelperText=""
                    Hint="Email"
                    OutlineCornerRadius="12"
                    Stroke="#4CAF50">
                    <Entry
                        x:Name="EmailEntry"
                        FontFamily="poppinregular"
                        FontSize="16"
                        Keyboard="Email"
                        Placeholder="Enter your email"
                        Text="{Binding Email}"
                        TextColor="#333333"
                        VerticalOptions="Center" />
                </inputLayout:SfTextInputLayout>

                <!--  Password Input  -->
                <inputLayout:SfTextInputLayout
                    ContainerType="Outlined"
                    HelperText=""
                    Hint="Password"
                    OutlineCornerRadius="12"
                    Stroke="#4CAF50">
                    <Entry
                        x:Name="PasswordEntry"
                        FontFamily="poppinregular"
                        FontSize="16"
                        IsPassword="True"
                        Placeholder="Enter your password"
                        Text="{Binding Password}"
                        TextColor="#333333"
                        VerticalOptions="Center" />
                </inputLayout:SfTextInputLayout>

                <!--  Forgot Password  -->
                <Label
                    Margin="0,0,5,0"
                    HorizontalOptions="End"
                    Style="{StaticResource SmallTextStyle}"
                    Text="Forgot Password?"
                    TextColor="#4CAF50" />
            </VerticalStackLayout>

            <!--  Login Button  -->
            <Button
                Background="{StaticResource SalesCardStyle.Background}"
                Command="{Binding LoginCommand}"
                CornerRadius="12"
                FontFamily="poppinbold"
                FontSize="16"
                HeightRequest="55"
                Text="Sign In"
                TextColor="White" />

            <!--  Divider with OR  -->
            <Grid Margin="0,10" ColumnDefinitions="*,Auto,*">
                <BoxView
                    Grid.Column="0"
                    HeightRequest="1"
                    VerticalOptions="Center"
                    Color="#E0E0E0" />
                <Label
                    Grid.Column="1"
                    Margin="15,0"
                    Style="{StaticResource SmallTextStyle}"
                    Text="OR" />
                <BoxView
                    Grid.Column="2"
                    HeightRequest="1"
                    VerticalOptions="Center"
                    Color="#E0E0E0" />
            </Grid>

            <!--  Google Sign In Button  -->
            <Border
                BackgroundColor="White"
                HeightRequest="55"
                Stroke="#E0E0E0"
                StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoogleSignInCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="10"
                    VerticalOptions="Center">
                    <Image
                        HeightRequest="24"
                        Source="google_icon.png"
                        WidthRequest="24" />
                    <Label
                        FontFamily="poppinregular"
                        FontSize="16"
                        Text="Sign in with Google"
                        TextColor="Black"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!--  Sign Up Section  -->
            <HorizontalStackLayout
                Margin="0,10,0,30"
                HorizontalOptions="Center"
                Spacing="5">
                <Label
                    Style="{StaticResource RegularTextStyle}"
                    Text="Don't have an account?"
                    TextColor="#666666" />
                <Label
                    Style="{StaticResource RegularTextStyle}"
                    Text="Sign Up"
                    TextColor="#4CAF50">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SignUpCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!--  Loading Indicator  -->
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#4CAF50" />

            <!--  Error Message  -->
            <Label
                HorizontalOptions="Center"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                Text="{Binding ErrorMessage}"
                TextColor="Red" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>