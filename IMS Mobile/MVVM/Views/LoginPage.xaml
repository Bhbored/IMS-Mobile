<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IMS_Mobile.MVVM.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Converters="clr-namespace:IMS_Mobile.Converters"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                      Dark={StaticResource DarkBackground}}">
    <ContentPage.Resources>
        <Converters:StringToBoolConverter x:Key="StringToBoolConverter" />
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <!--  Header Section  -->
            <VerticalStackLayout Spacing="8">
                <Label
                    HorizontalOptions="Center"
                    StyleClass="TitleStyle"
                    Text="Welcome Back" />
                <Label
                    HorizontalOptions="Center"
                    StyleClass="RegularTextStyle"
                    Text="Sign in to continue"
                    TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                Dark={StaticResource DarkOnSurface}}" />
            </VerticalStackLayout>

            <!--  Login Form  -->
            <VerticalStackLayout Spacing="20">
                <!--  Email Input  -->
                <inputLayout:SfTextInputLayout
                    ContainerType="Outlined"
                    HelperText=""
                    Hint="Email"
                    OutlineCornerRadius="12"
                    Stroke="#4CAF50">
                    <Entry
                        x:Name="EmailEntry"
                        FontFamily="poppinregular"
                        FontSize="16"
                        Keyboard="Email"
                        Placeholder="Enter your email"
                        Text="{Binding Email}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                    Dark={StaticResource DarkOnSurface}}"
                        VerticalOptions="Center" />
                </inputLayout:SfTextInputLayout>
                <Label
                    FontFamily="poppinregular"
                    FontSize="12"
                    IsVisible="{Binding EmailError, Converter={StaticResource StringToBoolConverter}}"
                    Text="{Binding EmailError, StringFormat='! {0}'}"
                    TextColor="Red" />

                <!--  Password Input  -->
                <inputLayout:SfTextInputLayout
                    ContainerType="Outlined"
                    HelperText=""
                    Hint="Password"
                    OutlineCornerRadius="12"
                    Stroke="#4CAF50">
                    <Entry
                        x:Name="PasswordEntry"
                        FontFamily="poppinregular"
                        FontSize="16"
                        IsPassword="True"
                        Keyboard="Password"
                        Placeholder="Enter your password"
                        Text="{Binding Password}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                    Dark={StaticResource DarkOnSurface}}"
                        VerticalOptions="Center" />
                </inputLayout:SfTextInputLayout>
                <Label
                    FontFamily="poppinregular"
                    FontSize="12"
                    IsVisible="{Binding PasswordError, Converter={StaticResource StringToBoolConverter}}"
                    Text="{Binding PasswordError, StringFormat='! {0}'}"
                    TextColor="Red" />

                <!--  Forgot Password  -->
                <Label
                    Margin="0,0,5,0"
                    HorizontalOptions="End"
                    StyleClass="SmallTextStyle"
                    Text="Forgot Password?"
                    TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                Dark={StaticResource ModernGreen}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <!--  Loading Indicator  -->
                <Image
                    HeightRequest="100"
                    IsAnimationPlaying="True"
                    IsVisible="{Binding IsBusy}"
                    Source="loader.gif"
                    WidthRequest="100" />
            </VerticalStackLayout>
            <!--  Login Button  -->
            <Button
                Background="#4CAF50"
                Command="{Binding LoginCommand}"
                CornerRadius="12"
                FontFamily="poppinbold"
                FontSize="16"
                HeightRequest="55"
                Text="Sign In"
                TextColor="White" />

            <!--  Divider with OR  -->
            <Grid Margin="0,10" ColumnDefinitions="*,Auto,*">
                <BoxView
                    Grid.Column="0"
                    HeightRequest="1"
                    VerticalOptions="Center"
                    Color="#E0E0E0" />
                <Label
                    Grid.Column="1"
                    Margin="15,0"
                    StyleClass="SmallTextStyle"
                    Text="OR" />
                <BoxView
                    Grid.Column="2"
                    HeightRequest="1"
                    VerticalOptions="Center"
                    Color="#E0E0E0" />
            </Grid>

            <!--  Google Sign In Button  -->
            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                                  Dark={StaticResource DarkSurface}}"
                HeightRequest="55"
                Stroke="#E0E0E0"
                StrokeShape="RoundRectangle 12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LoginWithGoogleCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="10"
                    VerticalOptions="Center">
                    <Image
                        HeightRequest="24"
                        Source="google.png"
                        WidthRequest="24" />
                    <Label
                        FontFamily="poppinregular"
                        FontSize="16"
                        Text="Sign in with Google"
                        TextColor="{AppThemeBinding Light={StaticResource Black},
                                                    Dark={StaticResource DarkOnSurface}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!--  Sign Up Section  -->
            <HorizontalStackLayout
                Margin="0,10,0,30"
                HorizontalOptions="Center"
                Spacing="5">
                <Label
                    StyleClass="RegularTextStyle"
                    Text="Don't have an account?"
                    TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                Dark={StaticResource DarkOnSurface}}" />
                <Label
                    StyleClass="RegularTextStyle"
                    Text="Sign Up"
                    TextColor="{AppThemeBinding Light={StaticResource Primary},
                                                Dark={StaticResource ModernGreen}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SignUpCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!--  Error Message  -->
            <Label
                HorizontalOptions="Center"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                Text="{Binding ErrorMessage}"
                TextColor="Red" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>