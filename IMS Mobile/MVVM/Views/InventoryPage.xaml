<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IMS_Mobile.MVVM.Views.InventoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Controls="clr-namespace:IMS_Mobile.Controls"
    xmlns:Converters="clr-namespace:IMS_Mobile.Converters"
    xmlns:Models="clr-namespace:IMS_Mobile.MVVM.Models"
    xmlns:ViewModels="clr-namespace:IMS_Mobile.MVVM.ViewModels"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    x:DataType="ViewModels:InventoryVM"
    BackgroundColor="{AppThemeBinding Light={StaticResource White},
                                      Dark={StaticResource DarkBackground}}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Converters:PriceCostConverter x:Key="PriceCostConverter" />
        <!--  Data Template for Inventory Items  -->
        <DataTemplate x:Key="InventoryItemTemplate" x:DataType="Models:Product">
            <Border StyleClass="TransactionCardStyle">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <!--  Product Image  -->
                    <Border
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        Background="#F5F5F5"
                        HeightRequest="60"
                        StrokeShape="RoundRectangle 8"
                        WidthRequest="60">
                        <Image
                            Aspect="AspectFill"
                            HorizontalOptions="Center"
                            Source="product.png"
                            VerticalOptions="Center" />
                    </Border>

                    <!--  Product Details  -->
                    <VerticalStackLayout
                        Grid.Row="0"
                        Grid.Column="1"
                        Spacing="4">
                        <Label
                            FontFamily="poppinbold"
                            FontSize="16"
                            Text="{Binding Name}"
                            TextColor="{AppThemeBinding Light={StaticResource Black},
                                                        Dark={StaticResource DarkOnSurface}}" />
                        <Label
                            FontFamily="poppinregular"
                            FontSize="14"
                            Text="{Binding Converter={StaticResource PriceCostConverter}}"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                        Dark={StaticResource DarkOnSurface}}" />
                    </VerticalStackLayout>

                    <!--  Stock Count  -->
                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        FontFamily="poppinregular"
                        FontSize="14"
                        Text="{Binding stock, StringFormat='{0} units'}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray500},
                                                    Dark={StaticResource DarkOnSurface}}"
                        VerticalOptions="End" />

                    <!--  Edit Icon  -->
                    <VerticalStackLayout
                        Grid.RowSpan="2"
                        Grid.Column="2"
                        Spacing="30"
                        VerticalOptions="Center">
                        <Border
                            Background="Transparent"
                            HeightRequest="24"
                            HorizontalOptions="End"
                            StrokeShape="RoundRectangle 5"
                            VerticalOptions="Center"
                            WidthRequest="24">
                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="✏️"
                                VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ViewModels:InventoryVM}}, Path=EditProductPop}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            Background="Transparent"
                            HeightRequest="24"
                            HorizontalOptions="End"
                            StrokeShape="RoundRectangle 5"
                            VerticalOptions="Center"
                            WidthRequest="24">
                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="🗑️"
                                VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ViewModels:InventoryVM}}, Path=DeleteProductPop}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>

                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Margin="20,0,20,10"
            ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                HorizontalOptions="Center"
                StyleClass="TitleStyle"
                Text="Inventory" />
            <Border
                Grid.Column="1"
                Background="{AppThemeBinding Light={StaticResource Gray100},
                                             Dark={StaticResource DarkSurface}}"
                HeightRequest="40"
                HorizontalOptions="End"
                StrokeShape="RoundRectangle 8"
                VerticalOptions="End"
                WidthRequest="40">
                <Label
                    FontSize="20"
                    HorizontalOptions="Center"
                    Text="🧊"
                    VerticalOptions="Center" />
            </Border>
        </Grid>

        <!--  Search Bar  -->
        <Border
            Grid.Row="1"
            Margin="20,10,20,20"
            Padding="16,12"
            Background="#F0F8F0"
            HeightRequest="70"
            StrokeShape="RoundRectangle 15">
            <Grid ColumnDefinitions="Auto,*">
                <Label
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    FontSize="16"
                    Text="🔍"
                    VerticalOptions="Center" />
                <editors:SfAutocomplete
                    x:Name="autocomplete"
                    Grid.Column="1"
                    Margin="0,5,0,0"
                    Background="Transparent"
                    DisplayMemberPath="Name"
                    EnableAutoSize="True"
                    HighlightedTextColor="{AppThemeBinding Light={StaticResource Primary},
                                                           Dark={StaticResource ModernGreen}}"
                    HighlightedTextFontAttributes="Bold"
                    HorizontalOptions="Fill"
                    ItemsSource="{Binding Products}"
                    MaxDropDownHeight="250"
                    Placeholder="Search Product ..."
                    PlaceholderColor="{AppThemeBinding Dark={StaticResource Black}}"
                    SelectedItems="{Binding SelectedProducts, Mode=TwoWay}"
                    SelectionChanged="autocomplete_SelectionChanged"
                    SelectionMode="Multiple"
                    SelectionTextHighlightColor="#4CAF50"
                    Stroke="Transparent"
                    StyleClass="TitleText"
                    TextColor="{AppThemeBinding Dark={StaticResource Black}}"
                    TextHighlightMode="FirstOccurrence"
                    TextMemberPath="Name"
                    TokensWrapMode="Wrap"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <!--  Inventory List  -->
        <RefreshView
            Grid.Row="2"
            Command="{Binding RefreshContactsCommand}"
            IsRefreshing="{Binding IsRefreshing}"
            RefreshColor="LightGreen">
            <CollectionView
                Margin="0,0,0,10"
                ItemTemplate="{StaticResource InventoryItemTemplate}"
                ItemsSource="{Binding FilteredProducts}"
                VerticalScrollBarVisibility="Always">
                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Image
                            Aspect="AspectFit"
                            HeightRequest="200"
                            IsAnimationPlaying="True"
                            IsVisible="{AppThemeBinding Light=True,
                                                        Dark=False}"
                            Source="emptyproduct.gif"
                            WidthRequest="200" />
                        <Label
                            Margin="0,20,0,0"
                            FontFamily="poppinbold"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="No Products yet"
                            VerticalOptions="Center" />
                    </StackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" />
                </CollectionView.ItemsLayout>
            </CollectionView>
        </RefreshView>

        <!--  Floating Action Button - Add Product  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Margin="0,0,20,30"
            Background="{AppThemeBinding Light={StaticResource ModernAccent},
                                         Dark={StaticResource Gray300}}"
            HeightRequest="60"
            HorizontalOptions="End"
            StrokeShape="RoundRectangle 20"
            VerticalOptions="End"
            WidthRequest="150">
            <Border.Shadow>
                <Shadow
                    Brush="#40000000"
                    Radius="8"
                    Offset="0,4" />
            </Border.Shadow>
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="2"
                VerticalOptions="Center">
                <Label
                    Margin="0,0,5,5"
                    FontSize="20"
                    HorizontalOptions="Start"
                    Text="➕"
                    TextColor="White"
                    VerticalOptions="Center" />
                <Label
                    FontFamily="poppinbold"
                    FontSize="15"
                    HorizontalOptions="Center"
                    Text="Add Product"
                    TextColor="White"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding NewProductPop}" />
            </Border.GestureRecognizers>
        </Border>

    </Grid>
</ContentPage>