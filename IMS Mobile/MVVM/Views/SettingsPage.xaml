<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IMS_Mobile.MVVM.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Settings"
    BackgroundColor="#F5F5F5">



    <!--  Scrollable Content  -->
    <ScrollView Grid.Row="1">
        <StackLayout Spacing="0">

            <!--  Profile Section  -->
            <Border Margin="15,20,15,10" StyleClass="SummaryCardStyle">
                <StackLayout Spacing="15">
                    <Label
                        Margin="0,0,0,10"
                        StyleClass="SectionTitleStyle"
                        Text="Profile" />

                    <!--  Avatar Section  -->
                    <StackLayout Spacing="10">
                        <Label StyleClass="RegularTextStyle" Text="Avatar" />
                        <Border
                            Padding="2"
                            Background="White"
                            HorizontalOptions="Center"
                            Stroke="LightGray"
                            StrokeShape="RoundRectangle 40"
                            StrokeThickness="1">
                            <Image
                                x:Name="avatarImage"
                                Aspect="AspectFill"
                                HeightRequest="80"
                                Source="user.png"
                                WidthRequest="80" />
                        </Border>
                        <Button
                            x:Name="changeAvatarButton"
                            Margin="0,5,0,10"
                            Clicked="OnChangeAvatarClicked"
                            HorizontalOptions="Center"
                            StyleClass="FilterButtonStyle"
                            Text="Change Avatar" />
                    </StackLayout>

                    <!--  Display Name  -->
                    <StackLayout Spacing="5">
                        <Label StyleClass="RegularTextStyle" Text="Display Name" />
                        <Border Padding="15,10" StyleClass="TransactionCardStyle">
                            <Entry
                                x:Name="displayNameEntry"
                                Placeholder="Enter your name"
                                StyleClass="RegularTextStyle"
                                TextChanged="OnDisplayNameChanged" />
                        </Border>
                    </StackLayout>
                </StackLayout>
            </Border>

            <!--  Preferences Section  -->
            <Border Margin="15,0,15,10" StyleClass="SummaryCardStyle">
                <StackLayout Spacing="15">
                    <Label
                        Margin="0,0,0,10"
                        StyleClass="SectionTitleStyle"
                        Text="Preferences" />

                    <!--  Theme Selection  -->
                    <StackLayout Spacing="5">
                        <Label StyleClass="RegularTextStyle" Text="Theme" />
                        <Border Padding="15,10" StyleClass="TransactionCardStyle">
                            <Picker
                                x:Name="themePicker"
                                SelectedIndexChanged="OnThemeChanged"
                                StyleClass="RegularTextStyle">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Light</x:String>
                                        <x:String>Dark</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </StackLayout>

                    <!--  Language Selection  -->
                    <StackLayout Spacing="5">
                        <Label StyleClass="RegularTextStyle" Text="Language" />
                        <Border Padding="15,10" StyleClass="TransactionCardStyle">
                            <Picker
                                x:Name="languagePicker"
                                SelectedIndexChanged="OnLanguageChanged"
                                StyleClass="RegularTextStyle">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>English</x:String>
                                        <x:String>Spanish</x:String>
                                        <x:String>French</x:String>
                                        <x:String>German</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </StackLayout>

                    <!--  Currency Selection  -->
                    <StackLayout Spacing="5">
                        <Label StyleClass="RegularTextStyle" Text="Currency" />
                        <Border Padding="15,10" StyleClass="TransactionCardStyle">
                            <Picker
                                x:Name="currencyPicker"
                                SelectedIndexChanged="OnCurrencyChanged"
                                StyleClass="RegularTextStyle">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>USD - US Dollar</x:String>
                                        <x:String>EUR - Euro</x:String>
                                        <x:String>GBP - British Pound</x:String>
                                        <x:String>JPY - Japanese Yen</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </StackLayout>
                </StackLayout>
            </Border>

            <!--  Actions Section  -->
            <Border Margin="15,0,15,20" StyleClass="SummaryCardStyle">
                <StackLayout Spacing="15">
                    <Label
                        Margin="0,0,0,10"
                        StyleClass="SectionTitleStyle"
                        Text="Actions" />

                    <!--  Save Button  -->
                    <Button
                        x:Name="saveButton"
                        Margin="0,10"
                        Clicked="OnSaveClicked"
                        StyleClass="CashButtonStyle"
                        Text="Save Settings" />

                    <!--  Reset Button  -->
                    <Button
                        x:Name="resetButton"
                        Margin="0,0,0,10"
                        Clicked="OnResetClicked"
                        StyleClass="FilterButtonStyle"
                        Text="Reset to Defaults" />
                </StackLayout>
            </Border>
        </StackLayout>
    </ScrollView>
</ContentPage>