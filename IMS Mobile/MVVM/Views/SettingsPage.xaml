<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IMS_Mobile.MVVM.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Settings"
    BackgroundColor="#F8F9FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--  Modern Layered Header  -->
        <Grid Grid.Row="0">
            <!--  Layer 1 - Back Layer  -->
            <Border StyleClass="HeaderLayer1Style"/>

            <!--  Layer 2 - Middle Layer  -->
            <Border StyleClass="HeaderLayer2Style"/>

            <!--  Layer 3 - Front Layer with Content  -->
            <Border StyleClass="HeaderLayer3Style">
                <StackLayout Spacing="6"
                             HorizontalOptions="Center">
                    <Label
                        FontFamily="poppinbold"
                        FontSize="22"
                        HorizontalOptions="Center"
                        Text="⚙️ Settings"
                        TextColor="White"/>
                    <Label
                        FontFamily="poppinregular"
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="Customize your experience"
                        TextColor="White"
                        Opacity="0.9"/>
                </StackLayout>
            </Border>
        </Grid>

        <!--  Scrollable Content  -->
        <ScrollView Grid.Row="1"
                    Padding="0,20,0,0">
            <StackLayout Spacing="0">

                <!--  Profile Section  -->
                <Border StyleClass="SettingsCardStyle">
                    <StackLayout Spacing="20">
                        <Label
                            StyleClass="SectionHeaderStyle"
                            Text="👤 Profile"/>

                        <!--  Avatar Section with Enhanced Design  -->
                        <StackLayout Spacing="15"
                                     HorizontalOptions="Center">
                            <Label
                                StyleClass="FieldLabelStyle"
                                HorizontalOptions="Center"
                                Text="Profile Picture"/>

                            <Border StyleClass="AvatarBorderStyle">
                                <Image
                                    x:Name="avatarImage"
                                    Aspect="AspectFill"
                                    HeightRequest="92"
                                    Source="user.png"
                                    WidthRequest="92"/>
                            </Border>

                            <Button
                                x:Name="changeAvatarButton"
                                Clicked="OnChangeAvatarClicked"
                                HorizontalOptions="Center"
                                StyleClass="ChangeAvatarButtonStyle"
                                Text="📷 Change Avatar"/>
                        </StackLayout>

                        <!--  Display Name with Enhanced Input  -->
                        <StackLayout Spacing="8">
                            <Label
                                StyleClass="FieldLabelStyle"
                                Text="Display Name"/>
                            <Border StyleClass="EntryContainerStyle">
                                <Entry
                                    x:Name="displayNameEntry"
                                    Placeholder="Enter your full name"
                                    StyleClass="SettingsEntryStyle"
                                    TextChanged="OnDisplayNameChanged"/>
                            </Border>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!--  Preferences Section  -->
                <Border StyleClass="SettingsCardStyle">
                    <StackLayout Spacing="20">
                        <Label
                            StyleClass="SectionHeaderStyle"
                            Text="⚙️ Preferences"/>

                        <!--  Theme Selection with Enhanced Design  -->
                        <StackLayout Spacing="8">
                            <Label
                                StyleClass="FieldLabelStyle"
                                Text="App Theme"/>
                            <Border StyleClass="PickerContainerStyle">
                                <Picker
                                    x:Name="themePicker"
                                    SelectedIndexChanged="OnThemeChanged"
                                    StyleClass="SettingsPickerStyle">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>☀️ Light Theme</x:String>
                                            <x:String>🌙 Dark Theme</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </StackLayout>

                        <!--  Currency Selection with Enhanced Design  -->
                        <StackLayout Spacing="8">
                            <Label
                                StyleClass="FieldLabelStyle"
                                Text="Currency"/>
                            <Border StyleClass="PickerContainerStyle">
                                <Picker
                                    x:Name="currencyPicker"
                                    SelectedIndexChanged="OnCurrencyChanged"
                                    StyleClass="SettingsPickerStyle">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>💵 USD - US Dollar</x:String>
                                            <x:String>💶 EUR - Euro</x:String>
                                            <x:String>💷 GBP - British Pound</x:String>
                                            <x:String>💴 JPY - Japanese Yen</x:String>
                                            <x:String>💸 LBP - Lebanese Pound</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Border>
                        </StackLayout>
                    </StackLayout>
                </Border>

                <!--  Actions Section with Enhanced Buttons  -->
                <Border StyleClass="SettingsCardStyle">
                    <StackLayout Spacing="20">
                        <Label
                            StyleClass="SectionHeaderStyle"
                            Text="🔧 Actions"/>

                        <!--  Save Button with Gradient  -->
                        <Button
                            x:Name="saveButton"
                            Clicked="OnSaveClicked"
                            StyleClass="SettingsButtonStyle,PrimaryButtonStyle"
                            Text="💾 Save Settings"/>

                        <!--  Reset Button with Secondary Style  -->
                        <Button
                            x:Name="resetButton"
                            Clicked="OnResetClicked"
                            StyleClass="SettingsButtonStyle,SecondaryButtonStyle"
                            Text="🔄 Reset to Defaults"/>
                    </StackLayout>
                </Border>

                <!--  Bottom Spacing  -->
                <BoxView HeightRequest="30"
                         Color="Transparent"/>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>