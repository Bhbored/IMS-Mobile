<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IMS_Mobile.MVVM.Views.GeneratedReport"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ViewModels="clr-namespace:IMS_Mobile.MVVM.ViewModels"
    xmlns:calendar="clr-namespace:Syncfusion.Maui.Calendar;assembly=Syncfusion.Maui.Calendar"
    xmlns:dataGrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    x:DataType="ViewModels:GeneratedReportVM"
    BackgroundColor="{AppThemeBinding Light={StaticResource White},
    Dark={StaticResource DarkBackground}}"
    Shell.NavBarIsVisible="True">


    <Shell.TitleView>
        <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
            <Border
                Background="{AppThemeBinding Light={StaticResource Gray100},
                Dark={StaticResource DarkSurface}}"
                HeightRequest="40"
                HorizontalOptions="End"
                StrokeShape="RoundRectangle 8"
                VerticalOptions="Center"
                WidthRequest="40">
                <Label
                    FontSize="20"
                    HorizontalOptions="Center"
                    Text="📊"
                    VerticalOptions="Center" />
            </Border>
            <Label
                FontFamily="poppinbold"
                FontSize="24"
                HorizontalOptions="Center"
                Text="Generated Report"
                TextColor="{AppThemeBinding Light={StaticResource Black},
                Dark={StaticResource DarkOnSurface}}"
                VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <ScrollView
            Grid.Row="0"
            Margin="20,10,20,0"
            Orientation="Horizontal">
            <HorizontalStackLayout Spacing="10">
                <Button
                    x:Name="FilterDay"
                    AutomationId="filterDay"
                    Clicked="FilterButton_Clicked"
                    Command="{Binding FilterByDay}"
                    FontAttributes="Bold"
                    HeightRequest="35"
                    StyleClass="FilterButtonStyle"
                    Text="1 Day"
                    WidthRequest="80" />

                <Button
                    x:Name="FilterWeek"
                    AutomationId="filterWeek"
                    Clicked="FilterButton_Clicked"
                    Command="{Binding FilterByWeek}"
                    FontAttributes="Bold"
                    HeightRequest="35"
                    StyleClass="FilterButtonStyle"
                    Text="1 Week"
                    WidthRequest="80" />

                <Button
                    x:Name="FilterMonth"
                    AutomationId="filterMonth"
                    Clicked="FilterButton_Clicked"
                    Command="{Binding FilterByMonth}"
                    FontAttributes="Bold"
                    HeightRequest="35"
                    StyleClass="ActiveFilterButtonStyle"
                    Text="1 Month"
                    WidthRequest="80" />
            </HorizontalStackLayout>
        </ScrollView>

        <Grid
            Grid.Row="1"
            Margin="20,10,20,0"
            ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontFamily="poppinbold"
                FontSize="14"
                Text="{Binding FilteredTransactions.Count, StringFormat='Total Transactions: {0}'}"
                TextColor="{AppThemeBinding Light={StaticResource Black},
                Dark={StaticResource DarkOnSurface}}" />

        </Grid>

        <!--  Calendar SfExpander  -->
        <syncfusion:SfExpander
            Grid.Row="2"
            Margin="20,10,20,0"
            IsExpanded="{Binding IsCustomDateRangeVisible}">
            <syncfusion:SfExpander.Header>
                <Border
                    Padding="20,15"
                    Background="{AppThemeBinding Light={StaticResource Gray100},
                    Dark={StaticResource DarkSurface}}"
                    StrokeShape="RoundRectangle 12">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label
                            FontSize="18"
                            Text="📅"
                            VerticalOptions="Center" />
                        <Label
                            FontFamily="poppinbold"
                            FontSize="16"
                            Text="Select Custom Date Range"
                            TextColor="{AppThemeBinding Light={StaticResource Black},
                            Dark={StaticResource DarkOnSurface}}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </syncfusion:SfExpander.Header>
            <syncfusion:SfExpander.Content>
                <Border
                    Margin="0,-10,0,0"
                    Padding="20,25,20,20"
                    Background="{AppThemeBinding Light={StaticResource Gray100},
                    Dark={StaticResource DarkSurface}}"
                    StrokeShape="RoundRectangle 0,0,12,12">
                    <StackLayout Spacing="15">
                        <calendar:SfCalendar
                            EnableSwipeSelection="True"
                            HeightRequest="300"
                            SelectedDateRange="{Binding SelectedDateRange}"
                            SelectionChanged="OnCalendarSelectionChanged"
                            SelectionMode="Range"
                            View="Month" />

                        <!--  Apply and Reset Buttons  -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">
                            <Button
                                Command="{Binding ApplyCustomDateRange}"
                                FontAttributes="Bold"
                                HeightRequest="40"
                                StyleClass="ActiveFilterButtonStyle"
                                Text="Apply Filter"
                                WidthRequest="120" />

                            <Button
                                Command="{Binding ResetCustomDateRange}"
                                FontAttributes="Bold"
                                HeightRequest="40"
                                StyleClass="FilterButtonStyle"
                                Text="Reset"
                                WidthRequest="80" />
                        </HorizontalStackLayout>
                    </StackLayout>
                </Border>
            </syncfusion:SfExpander.Content>
        </syncfusion:SfExpander>

        <Grid Grid.Row="3" Margin="20,10,20,20">
            <dataGrid:SfDataGrid
                x:Name="DataGrid"
                AllowPullToRefresh="False"
                AutoGenerateColumnsMode="None"
                BackgroundColor="Transparent"
                ItemsSource="{Binding FilteredTransactions}"
                SelectionMode="Single">

                <dataGrid:SfDataGrid.Columns>
                    <dataGrid:DataGridTextColumn
                        Width="80"
                        HeaderText="ID"
                        MappingName="Id" />

                    <dataGrid:DataGridTextColumn
                        Width="80"
                        HeaderText="Type"
                        MappingName="Type" />

                    <dataGrid:DataGridTextColumn
                        Width="200"
                        HeaderText="Amount"
                        MappingName="totalamount" />
                    <dataGrid:DataGridTextColumn
                        Width="80"
                        HeaderText="Status"
                        MappingName="Status" />
                    <dataGrid:DataGridTextColumn
                        Width="200"
                        HeaderText="Date"
                        MappingName="FormattedDate" />
                </dataGrid:SfDataGrid.Columns>
            </dataGrid:SfDataGrid>

            <Border
                Margin="0,0,10,10"
                Background="{AppThemeBinding Light={StaticResource ModernGreen},
                Dark={StaticResource ModernGreenDark}}"
                HeightRequest="60"
                HorizontalOptions="End"
                StrokeShape="RoundRectangle 12"
                VerticalOptions="End"
                WidthRequest="120">
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="8"
                    VerticalOptions="Center">
                    <Label
                        FontSize="16"
                        Text="📄"
                        VerticalOptions="Center" />
                    <Label
                        FontFamily="poppinbold"
                        FontSize="12"
                        Text="Export PDF"
                        TextColor="{AppThemeBinding Light={StaticResource White},
                        Dark={StaticResource White}}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ExportToPdf}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
    </Grid>
</ContentPage>